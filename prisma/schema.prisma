// OpenHRM data model
//
// Tenancy rule: every tenant-owned table carries `orgId` and indexes it first.
// Uniqueness is always scoped by `orgId` so two organisations can both have an
// "ENG" department or an employee coded "EMP-001". Application-level scoping is
// enforced by the Prisma client extension in src/lib/db.ts; Postgres RLS in
// prisma/migrations/*_rls is the second, independent safety net.
//
// Sensitive columns (bank account, PAN, Aadhaar) hold AES-256-GCM ciphertext
// produced by src/lib/crypto.ts — never plaintext. They are suffixed `Enc`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  EXITED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
}

enum AttendanceSource {
  WEB
  MOBILE
  BIOMETRIC
  IMPORT
  SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccrualFrequency {
  NONE
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveLedgerReason {
  OPENING_BALANCE
  ACCRUAL
  CARRY_FORWARD
  CONSUMED
  REVERSED
  ADJUSTMENT
  ENCASHMENT
  LAPSED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum NotificationType {
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  REGULARIZATION_REQUESTED
  REGULARIZATION_APPROVED
  REGULARIZATION_REJECTED
  EMPLOYEE_JOINED
  ANNOUNCEMENT
  BIRTHDAY
  WORK_ANNIVERSARY
  INVITATION
  PAYSLIP_PUBLISHED
  TASK_ASSIGNED
  DOCUMENT_EXPIRING
  POLICY_PUBLISHED
  ASSET_ASSIGNED
  EXPENSE_SUBMITTED
  EXPENSE_DECIDED
  TICKET_RAISED
  TICKET_UPDATED
  INTERVIEW_SCHEDULED
  CANDIDATE_MOVED
  REVIEW_DUE
  GOAL_ASSIGNED
  COURSE_ASSIGNED
  SURVEY_OPEN
  RESIGNATION_SUBMITTED
  CLEARANCE_PENDING
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  LOCATION
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  industry             String?
  website              String?
  country              String   @default("IN")
  currency             String   @default("INR")
  timezone             String   @default("Asia/Kolkata")
  /// 1 = January. Drives leave-year boundaries and reporting periods.
  fiscalYearStartMonth Int      @default(4)
  /// ISO weekday numbers that count as working days (1 = Monday … 7 = Sunday).
  workingDays          Int[]    @default([1, 2, 3, 4, 5])

  // --- White-labelling (PRD §8.29) ----------------------------------------
  // Self-hosted orgs make the product look like theirs. These are read at
  // render time and injected as CSS custom properties, so a brand change is a
  // form submission rather than a rebuild.
  /// OKLCH triple ("0.55 0.18 265") so it drops straight into the token set.
  brandColor           String?
  faviconUrl           String?
  loginTagline         String?
  supportEmail         String?
  /// Serves the tenant when self-hosted behind a reverse proxy.
  customDomain         String?

  // --- Outbound integrations (PRD §8.24) ----------------------------------
  slackWebhookUrl      String?
  teamsWebhookUrl      String?

  /// Sequence source for helpdesk ticket numbers, so #1 means "first ticket
  /// this organisation raised" rather than a global counter.
  ticketSequence       Int      @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users           User[]
  employees       Employee[]
  departments     Department[]
  designations    Designation[]
  locations       Location[]
  roles           Role[]
  invitations     Invitation[]
  sessions        Session[]
  customFields    CustomFieldDefinition[]
  customValues    CustomFieldValue[]
  shifts          Shift[]
  attendance      AttendanceRecord[]
  regularizations AttendanceRegularization[]
  holidays        Holiday[]
  leaveTypes      LeaveType[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
  leaveLedger     LeaveLedgerEntry[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  announcements   Announcement[]

  // Phase 2 — payroll and workforce operations
  salaryComponents      SalaryComponent[]
  salaryStructures      SalaryStructure[]
  structureComponents   SalaryStructureComponent[]
  employeeSalaries      EmployeeSalary[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  payslipLines          PayslipLine[]
  statutorySetting      StatutorySetting?
  loans                 LoanAdvance[]
  checklistTemplates    ChecklistTemplate[]
  checklistTemplateItems ChecklistTemplateItem[]
  checklistInstances    ChecklistInstance[]
  checklistTasks        ChecklistTask[]
  employeeDocuments     EmployeeDocument[]
  policies              Policy[]
  policyAcknowledgements PolicyAcknowledgement[]
  letterTemplates       LetterTemplate[]
  generatedLetters      GeneratedLetter[]
  assetCategories       AssetCategory[]
  assets                Asset[]
  assetAssignments      AssetAssignment[]
  expenseCategories     ExpenseCategory[]
  expenseClaims         ExpenseClaim[]
  expenseItems          ExpenseItem[]
  ticketCategories      TicketCategory[]
  tickets               Ticket[]
  ticketComments        TicketComment[]

  // Phase 3 — talent and growth
  jobPostings           JobPosting[]
  candidates            Candidate[]
  interviews            Interview[]
  offers                Offer[]
  goals                 Goal[]
  reviewCycles          ReviewCycle[]
  performanceReviews    PerformanceReview[]
  oneOnOnes             OneOnOne[]
  courses               Course[]
  courseLessons         CourseLesson[]
  quizQuestions         QuizQuestion[]
  enrollments           CourseEnrollment[]
  surveys               Survey[]
  surveyQuestions       SurveyQuestion[]
  surveyResponses       SurveyResponse[]
  surveyAnswers         SurveyAnswer[]
  announcementReactions AnnouncementReaction[]
  resignations          Resignation[]
  exitInterviews        ExitInterview[]
  settlements           FinalSettlement[]

  // Phase 4 — platform
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  savedReports          SavedReport[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Identity, access control
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  orgId           String
  email           String
  passwordHash    String
  name            String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  roleId          String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role     Role         @relation(fields: [roleId], references: [id])
  employee Employee?

  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  invitationsSent Invitation[]       @relation("InvitedBy")
  announcements   Announcement[]
  ledgerEntries   LeaveLedgerEntry[] @relation("LedgerCreatedBy")

  salaryRevisions       EmployeeSalary[]       @relation("SalaryCreatedBy")
  payrollRunsApproved   PayrollRun[]           @relation("PayrollApprover")
  documentsUploaded     EmployeeDocument[]     @relation("DocumentUploader")
  policiesAuthored      Policy[]               @relation("PolicyAuthor")
  lettersIssued         GeneratedLetter[]      @relation("LetterIssuer")
  assetsIssued          AssetAssignment[]      @relation("AssetIssuer")
  ticketComments        TicketComment[]        @relation("CommentAuthor")
  jobsCreated           JobPosting[]           @relation("JobCreatedBy")
  offersCreated         Offer[]                @relation("OfferCreatedBy")
  coursesCreated        Course[]               @relation("CourseAuthor")
  surveysCreated        Survey[]               @relation("SurveyAuthor")
  reactions             AnnouncementReaction[]
  settlementsApproved   FinalSettlement[]      @relation("SettlementApprover")
  apiKeysCreated        ApiKey[]               @relation("ApiKeyCreator")
  webhooksCreated       WebhookEndpoint[]      @relation("WebhookCreator")
  savedReports          SavedReport[]          @relation("ReportAuthor")

  /// Scoped by org: the same person may hold accounts in two organisations on
  /// the hosted platform. Login resolves email -> candidate orgs.
  @@unique([orgId, email])
  @@index([email])
  @@index([orgId, roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  /// Permission keys from src/lib/permissions.ts. Stored as an array so admins
  /// can compose custom roles ("Payroll-only HR", "Read-only Auditor") without
  /// a schema change — the PRD's configurable permission matrix.
  permissions String[]
  /// System roles ship with every org and cannot be deleted.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("roles")
}

model Session {
  id               String    @id @default(cuid())
  orgId            String
  userId           String
  /// SHA-256 of the refresh token. The raw token never touches the database.
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id          String         @id @default(cuid())
  orgId       String
  email       String
  name        String?
  roleId      String
  tokenHash   String         @unique
  invitedById String?
  status      ApprovalStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      Role         @relation(fields: [roleId], references: [id])
  invitedBy User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, email])
  @@index([orgId, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Organisation structure
// ---------------------------------------------------------------------------

model Department {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  code     String
  parentId String?
  headId   String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  head     Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  employees     Employee[]
  announcements Announcement[]
  jobPostings   JobPosting[]
  goals         Goal[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([parentId])
  @@map("departments")
}

model Designation {
  id    String @id @default(cuid())
  orgId String
  title String
  /// Seniority rank used for org-chart ordering and reporting.
  level Int    @default(0)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([orgId, title])
  @@index([orgId])
  @@map("designations")
}

model Location {
  id             String  @id @default(cuid())
  orgId          String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String  @default("IN")
  postalCode     String?
  timezone       String  @default("Asia/Kolkata")
  isHeadquarters Boolean @default(false)

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees     Employee[]
  holidays      Holiday[]
  announcements Announcement[]
  jobPostings   JobPosting[]
  assets        Asset[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Core HR
// ---------------------------------------------------------------------------

model Employee {
  id           String  @id @default(cuid())
  orgId        String
  employeeCode String
  firstName    String
  lastName     String
  displayName  String?
  avatarUrl    String?

  workEmail     String
  personalEmail String?
  phone         String?
  dateOfBirth   DateTime?
  gender        Gender?
  bloodGroup    String?
  maritalStatus String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  departmentId     String?
  designationId    String?
  locationId       String?
  managerId        String?
  shiftId          String?
  employmentType   EmploymentType @default(FULL_TIME)
  status           EmployeeStatus @default(ACTIVE)
  dateOfJoining    DateTime
  dateOfExit       DateTime?
  probationEndDate DateTime?
  noticePeriodDays Int            @default(30)

  /// Visible only to roles holding `employee.compensation.read`.
  ctcAnnual Decimal? @db.Decimal(14, 2)

  // AES-256-GCM ciphertext — see src/lib/crypto.ts. Never log or export raw.
  bankAccountNumberEnc String?
  bankIfsc             String?
  bankName             String?
  panNumberEnc         String?
  aadhaarNumberEnc     String?

  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  manager     Employee?    @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports     Employee[]   @relation("ReportingLine")

  headsDepartments Department[]               @relation("DepartmentHead")
  customValues     CustomFieldValue[]
  attendance       AttendanceRecord[]
  regularizations  AttendanceRegularization[] @relation("RegularizationOwner")
  reviewedRegs     AttendanceRegularization[] @relation("RegularizationReviewer")
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]             @relation("LeaveOwner")
  approvedLeaves   LeaveRequest[]             @relation("LeaveApprover")
  leaveLedger      LeaveLedgerEntry[]

  // Phase 2
  salaries          EmployeeSalary[]
  payslips          Payslip[]
  loans             LoanAdvance[]
  journeys          ChecklistInstance[]
  assignedTasks     ChecklistTask[]      @relation("TaskAssignee")
  documents         EmployeeDocument[]
  policyAcks        PolicyAcknowledgement[]
  letters           GeneratedLetter[]
  assetAssignments  AssetAssignment[]
  expenseClaims     ExpenseClaim[]       @relation("ClaimOwner")
  approvedClaims    ExpenseClaim[]       @relation("ClaimApprover")
  ticketsRaised     Ticket[]             @relation("TicketRequester")
  ticketsAssigned   Ticket[]             @relation("TicketAssignee")
  defaultForQueues  TicketCategory[]     @relation("QueueDefaultAssignee")

  // Phase 3
  jobsHiring        JobPosting[]         @relation("HiringManager")
  jobsRecruiting    JobPosting[]         @relation("Recruiter")
  candidatesOwned   Candidate[]          @relation("CandidateOwner")
  interviewsGiven   Interview[]          @relation("Interviewer")
  hiredFromOffer    Offer[]              @relation("OfferHire")
  goals             Goal[]               @relation("GoalOwner")
  reviewsReceived   PerformanceReview[]  @relation("ReviewSubject")
  reviewsGiven      PerformanceReview[]  @relation("Reviewer")
  oneOnOnesLed      OneOnOne[]           @relation("OneOnOneManager")
  oneOnOnesAttended OneOnOne[]           @relation("OneOnOneEmployee")
  enrollments       CourseEnrollment[]
  enrollmentsAssigned CourseEnrollment[] @relation("EnrollmentAssigner")
  surveyResponses   SurveyResponse[]
  resignations      Resignation[]        @relation("ResignationOwner")
  resignationsDecided Resignation[]      @relation("ResignationDecider")
  exitInterviews    ExitInterview[]      @relation("ExitInterviewee")
  exitInterviewsConducted ExitInterview[] @relation("ExitInterviewer")
  settlements       FinalSettlement[]

  @@unique([orgId, employeeCode])
  @@unique([orgId, workEmail])
  @@index([orgId, status])
  @@index([orgId, departmentId])
  @@index([orgId, managerId])
  @@index([orgId, lastName, firstName])
  @@map("employees")
}

model CustomFieldDefinition {
  id       String          @id @default(cuid())
  orgId    String
  key      String
  label    String
  helpText String?
  type     CustomFieldType @default(TEXT)
  /// Choices when type = SELECT.
  options  String[]        @default([])
  section  String          @default("Additional")
  required Boolean         @default(false)
  sortdex  Int             @default(0)
  isActive Boolean         @default(true)

  org    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([orgId, key])
  @@index([orgId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String  @id @default(cuid())
  orgId        String
  definitionId String
  employeeId   String
  value        String?

  org        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([definitionId, employeeId])
  @@index([orgId, employeeId])
  @@map("custom_field_values")
}

// ---------------------------------------------------------------------------
// Attendance and time
// ---------------------------------------------------------------------------

model Shift {
  id           String  @id @default(cuid())
  orgId        String
  name         String
  /// "HH:mm" in the organisation's timezone.
  startTime    String  @default("09:30")
  endTime      String  @default("18:30")
  breakMinutes Int     @default(60)
  /// Late arrival tolerated before a day is flagged.
  graceMinutes Int     @default(15)
  halfDayHours Decimal @default(4) @db.Decimal(4, 2)
  fullDayHours Decimal @default(8) @db.Decimal(4, 2)
  isDefault    Boolean @default(false)

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees  Employee[]
  attendance AttendanceRecord[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("shifts")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  orgId         String
  employeeId    String
  /// Date-only — one row per employee per calendar day.
  date          DateTime         @db.Date
  checkInAt     DateTime?
  checkOutAt    DateTime?
  workedMinutes Int              @default(0)
  status        AttendanceStatus @default(ABSENT)
  shiftId       String?
  source        AttendanceSource @default(WEB)
  isLate        Boolean          @default(false)
  isRegularized Boolean          @default(false)
  note          String?
  checkInLat    Float?
  checkInLng    Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  regularizations AttendanceRegularization[]

  @@unique([employeeId, date])
  @@index([orgId, date])
  @@index([orgId, employeeId, date])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                  String         @id @default(cuid())
  orgId               String
  employeeId          String
  attendanceRecordId  String?
  date                DateTime       @db.Date
  requestedCheckInAt  DateTime
  requestedCheckOutAt DateTime
  reason              String
  status              ApprovalStatus @default(PENDING)
  reviewerId          String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime       @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee   Employee          @relation("RegularizationOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee?         @relation("RegularizationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attendance AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([orgId, employeeId])
  @@map("attendance_regularizations")
}

model Holiday {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  date       DateTime @db.Date
  /// Null = applies to every location.
  locationId String?
  /// Restricted holidays: employees choose N from the optional pool.
  isOptional Boolean  @default(false)

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([orgId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                 String           @id @default(cuid())
  orgId              String
  name               String
  code               String
  description        String?
  /// Chart/badge token name (chart-1 … chart-5) so colours stay themeable.
  colorToken         String           @default("chart-1")
  isPaid             Boolean          @default(true)
  requiresApproval   Boolean          @default(true)
  allowHalfDay       Boolean          @default(true)
  /// Counts weekends/holidays inside the range as leave when true.
  countsHolidays     Boolean          @default(false)
  accrualFrequency   AccrualFrequency @default(MONTHLY)
  accrualAmount      Decimal          @default(0) @db.Decimal(6, 2)
  openingBalance     Decimal          @default(0) @db.Decimal(6, 2)
  maxBalance         Decimal?         @db.Decimal(6, 2)
  carryForward       Boolean          @default(false)
  carryForwardCap    Decimal?         @db.Decimal(6, 2)
  maxConsecutiveDays Int?
  minNoticeDays      Int              @default(0)
  /// Restrict to a gender (maternity/paternity). Null = everyone.
  applicableGender   Gender?
  isActive           Boolean          @default(true)
  sortdex            Int              @default(0)

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("leave_types")
}

model LeaveBalance {
  id             String  @id @default(cuid())
  orgId          String
  employeeId     String
  leaveTypeId    String
  /// Leave year, keyed by the org's fiscal year start.
  year           Int
  openingBalance Decimal @default(0) @db.Decimal(6, 2)
  accrued        Decimal @default(0) @db.Decimal(6, 2)
  carriedForward Decimal @default(0) @db.Decimal(6, 2)
  adjusted       Decimal @default(0) @db.Decimal(6, 2)
  used           Decimal @default(0) @db.Decimal(6, 2)
  /// Reserved by requests awaiting approval, so balance can't be double-spent.
  pending        Decimal @default(0) @db.Decimal(6, 2)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([orgId, year])
  @@map("leave_balances")
}

/// Append-only history of every balance movement. The balance row is a
/// materialised sum of these entries, so any number on screen can be explained.
model LeaveLedgerEntry {
  id             String            @id @default(cuid())
  orgId          String
  employeeId     String
  leaveTypeId    String
  year           Int
  delta          Decimal           @db.Decimal(6, 2)
  reason         LeaveLedgerReason
  leaveRequestId String?
  note           String?
  createdById    String?
  createdAt      DateTime          @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId, leaveTypeId, year])
  @@map("leave_ledger_entries")
}

model LeaveRequest {
  id                 String          @id @default(cuid())
  orgId              String
  employeeId         String
  leaveTypeId        String
  startDate          DateTime        @db.Date
  endDate            DateTime        @db.Date
  isHalfDay          Boolean         @default(false)
  halfDaySession     HalfDaySession?
  /// Working days consumed, computed server-side — 0.5 granularity.
  days               Decimal         @db.Decimal(5, 2)
  reason             String
  status             ApprovalStatus  @default(PENDING)
  approverId         String?
  decidedAt          DateTime?
  decisionNote       String?
  cancelledAt        DateTime?
  contactDuringLeave String?
  documentUrl        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee  Employee     @relation("LeaveOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approver  Employee?    @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  ledgerEntries LeaveLedgerEntry[]

  @@index([orgId, status])
  @@index([orgId, employeeId])
  @@index([orgId, startDate, endDate])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Communication, audit
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId, createdAt])
  @@map("notifications")
}

model Announcement {
  id           String               @id @default(cuid())
  orgId        String
  title        String
  body         String
  authorId     String?
  audience     AnnouncementAudience @default(ALL)
  departmentId String?
  locationId   String?
  isPinned     Boolean              @default(false)
  publishedAt  DateTime             @default(now())
  createdAt    DateTime             @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  reactions AnnouncementReaction[]

  @@index([orgId, publishedAt])
  @@map("announcements")
}

/// Immutable record of sensitive actions. Written by src/lib/audit.ts; nothing
/// in the application updates or deletes rows here.
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String?
  /// Denormalised so the log survives the actor being deleted.
  actorLabel  String
  action      String
  entityType  String
  entityId    String?
  summary     String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("audit_logs")
}

// ===========================================================================
// Phase 2 â€” Payroll & workforce operations
// ===========================================================================

enum SalaryComponentType {
  EARNING
  DEDUCTION
  /// Costs the employer but never appears in net pay (PF employer share, ESI).
  EMPLOYER_CONTRIBUTION
}

enum SalaryCalculation {
  /// A fixed amount per month.
  FLAT
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  /// Whatever is left of gross after every other earning â€” the classic
  /// "special allowance" that makes a structure add up exactly.
  BALANCE
  /// Computed by the statutory engine rather than by the structure.
  STATUTORY
}

enum PayrollRunStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

/// A line item that can appear on a payslip: Basic, HRA, PF, TDSâ€¦
model SalaryComponent {
  id           String              @id @default(cuid())
  orgId        String
  name         String
  code         String
  type         SalaryComponentType @default(EARNING)
  calculation  SalaryCalculation   @default(FLAT)
  /// A percentage when calculation is PERCENT_OF_*, an amount when FLAT.
  defaultValue Decimal             @default(0) @db.Decimal(12, 2)
  /// Feeds taxable income for TDS.
  isTaxable    Boolean             @default(true)
  /// Statutory components are computed by the compliance pack, not by admins.
  isStatutory  Boolean             @default(false)
  /// Excluded components (reimbursements) sit outside the CTC figure.
  includeInCtc Boolean             @default(true)
  description  String?
  sortdex      Int                 @default(0)
  isActive     Boolean             @default(true)

  org        Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  structures SalaryStructureComponent[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("salary_components")
}

/// A named recipe â€” "Standard (India)", "Consultant" â€” that turns one CTC
/// figure into a full set of payslip lines.
model SalaryStructure {
  id          String  @id @default(cuid())
  orgId       String
  name        String
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  org        Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  components SalaryStructureComponent[]
  salaries   EmployeeSalary[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  id          String   @id @default(cuid())
  orgId       String
  structureId String
  componentId String
  /// Overrides the component default for this structure. Null = use default.
  value       Decimal? @db.Decimal(12, 2)
  sortdex     Int      @default(0)

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([structureId, componentId])
  @@index([orgId])
  @@map("salary_structure_components")
}

/// Compensation, versioned. A raise appends a row and closes the previous one
/// rather than overwriting it, so a payslip issued last March can still be
/// explained by the numbers that were true in March.
model EmployeeSalary {
  id            String    @id @default(cuid())
  orgId         String
  employeeId    String
  structureId   String
  annualCtc     Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id])
  createdBy User?           @relation("SalaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId, effectiveFrom])
  @@map("employee_salaries")
}

/// One month of payroll for the whole organisation.
model PayrollRun {
  id                String           @id @default(cuid())
  orgId             String
  periodMonth       Int
  periodYear        Int
  status            PayrollRunStatus @default(DRAFT)
  payDate           DateTime?        @db.Date
  headcount         Int              @default(0)
  totalGross        Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions   Decimal          @default(0) @db.Decimal(14, 2)
  totalNet          Decimal          @default(0) @db.Decimal(14, 2)
  totalEmployerCost Decimal          @default(0) @db.Decimal(14, 2)
  note              String?
  processedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User?          @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payslips   Payslip[]
  claims     ExpenseClaim[]

  @@unique([orgId, periodYear, periodMonth])
  @@index([orgId, status])
  @@map("payroll_runs")
}

model Payslip {
  id                    String    @id @default(cuid())
  orgId                 String
  payrollRunId          String
  employeeId            String
  /// Snapshot, so a payslip stays readable after a rename or a transfer.
  employeeCode          String
  employeeName          String
  designationTitle      String?
  departmentName        String?
  workingDays           Decimal   @db.Decimal(5, 2)
  paidDays              Decimal   @db.Decimal(5, 2)
  /// Loss of pay: unpaid leave and unexplained absence.
  lopDays               Decimal   @default(0) @db.Decimal(5, 2)
  grossEarnings         Decimal   @default(0) @db.Decimal(14, 2)
  totalDeductions       Decimal   @default(0) @db.Decimal(14, 2)
  employerContributions Decimal   @default(0) @db.Decimal(14, 2)
  netPay                Decimal   @default(0) @db.Decimal(14, 2)
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run      PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    PayslipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([orgId, employeeId])
  @@map("payslips")
}

model PayslipLine {
  id        String              @id @default(cuid())
  orgId     String
  payslipId String
  code      String
  label     String
  type      SalaryComponentType
  amount    Decimal             @db.Decimal(14, 2)
  /// Shown under the line â€” "12% of basic, capped at 15,000".
  basis     String?
  sortdex   Int                 @default(0)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslip Payslip      @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([orgId, payslipId])
  @@map("payslip_lines")
}

/// Configuration for the India compliance pack (PRD Â§8.7).
///
/// Rates live in data, not in code, because they move with each budget and
/// because a self-hoster in another country needs to switch them off entirely.
/// The PRD is explicit that compliance packs are community-maintained â€” the UI
/// says so, and nothing here is presented as tax advice.
model StatutorySetting {
  id                String   @id @default(cuid())
  orgId             String   @unique
  countryCode       String   @default("IN")

  pfEnabled         Boolean  @default(true)
  /// Monthly wage ceiling the 12% is calculated on.
  pfWageCeiling     Decimal  @default(15000) @db.Decimal(12, 2)
  pfEmployeeRate    Decimal  @default(12) @db.Decimal(5, 2)
  pfEmployerRate    Decimal  @default(12) @db.Decimal(5, 2)
  /// Employers above the ceiling may still contribute on full basic.
  pfCapAtCeiling    Boolean  @default(true)

  esiEnabled        Boolean  @default(true)
  esiWageCeiling    Decimal  @default(21000) @db.Decimal(12, 2)
  esiEmployeeRate   Decimal  @default(0.75) @db.Decimal(5, 2)
  esiEmployerRate   Decimal  @default(3.25) @db.Decimal(5, 2)

  ptEnabled         Boolean  @default(true)
  /// [{ upTo: number | null, amount: number }] â€” evaluated in order.
  ptSlabs           Json     @default("[]")

  tdsEnabled        Boolean  @default(true)
  /// "NEW" or "OLD" â€” the regime the estimator assumes.
  tdsRegime         String   @default("NEW")
  standardDeduction Decimal  @default(75000) @db.Decimal(12, 2)
  /// [{ upTo: number | null, rate: number }] â€” annual income slabs.
  tdsSlabs          Json     @default("[]")

  gratuityEnabled   Boolean  @default(true)
  /// Years of service before gratuity vests.
  gratuityMinYears  Int      @default(5)

  updatedAt         DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("statutory_settings")
}

/// Salary advances and loans, recovered by instalment during the payroll run.
model LoanAdvance {
  id                String     @id @default(cuid())
  orgId             String
  employeeId        String
  reason            String
  principal         Decimal    @db.Decimal(12, 2)
  installmentAmount Decimal    @db.Decimal(12, 2)
  installmentsTotal Int
  installmentsPaid  Int        @default(0)
  recovered         Decimal    @default(0) @db.Decimal(12, 2)
  startMonth        Int
  startYear         Int
  status            LoanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, employeeId, status])
  @@map("loans_advances")
}

// ---------------------------------------------------------------------------
// Onboarding and offboarding (PRD Â§8.4)
// ---------------------------------------------------------------------------

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChecklistTaskStatus {
  PENDING
  DONE
  SKIPPED
  BLOCKED
}

model ChecklistTemplate {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  kind        ChecklistKind @default(ONBOARDING)
  description String?
  isDefault   Boolean       @default(false)
  isActive    Boolean       @default(true)

  org       Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items     ChecklistTemplateItem[]
  instances ChecklistInstance[]

  @@unique([orgId, name])
  @@index([orgId, kind])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String  @id @default(cuid())
  orgId       String
  templateId  String
  title       String
  description String?
  /// Which function owns it: IT, Finance, HR, Admin, Manager.
  category    String  @default("HR")
  /// Days relative to the join or exit date. -3 = three days before day one.
  offsetDays  Int     @default(0)
  sortdex     Int     @default(0)

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([orgId, templateId])
  @@map("checklist_template_items")
}

/// One employee running through a template â€” their onboarding, or their exit
/// clearance. Called a "journey" in the UI, because "instance" means nothing
/// to an HR manager.
model ChecklistInstance {
  id          String          @id @default(cuid())
  orgId       String
  employeeId  String
  templateId  String?
  kind        ChecklistKind
  name        String
  status      ChecklistStatus @default(NOT_STARTED)
  /// Join date for onboarding, last working day for offboarding.
  anchorDate  DateTime        @db.Date
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks       ChecklistTask[]
  resignation Resignation?

  @@index([orgId, kind, status])
  @@index([orgId, employeeId])
  @@map("checklist_instances")
}

model ChecklistTask {
  id          String              @id @default(cuid())
  orgId       String
  instanceId  String
  title       String
  description String?
  category    String              @default("HR")
  assigneeId  String?
  dueDate     DateTime?           @db.Date
  status      ChecklistTaskStatus @default(PENDING)
  completedAt DateTime?
  note        String?
  sortdex     Int                 @default(0)

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  instance ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee Employee?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, assigneeId, status])
  @@index([orgId, instanceId])
  @@map("checklist_tasks")
}

// ---------------------------------------------------------------------------
// Documents, policies, letters (PRD Â§8.14)
// ---------------------------------------------------------------------------

enum DocumentCategory {
  ID_PROOF
  CONTRACT
  CERTIFICATE
  EDUCATION
  PAYROLL
  MEDICAL
  OTHER
}

model EmployeeDocument {
  id             String           @id @default(cuid())
  orgId          String
  employeeId     String
  name           String
  category       DocumentCategory @default(OTHER)
  /// Object-storage key or URL. Self-hosted installs point this at MinIO.
  fileUrl        String
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  issuedOn       DateTime?        @db.Date
  /// Drives the expiry reminders the PRD asks for (visas, passports).
  expiresOn      DateTime?        @db.Date
  isConfidential Boolean          @default(false)
  uploadedById   String?
  createdAt      DateTime         @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId])
  @@index([orgId, expiresOn])
  @@map("employee_documents")
}

model Policy {
  id                      String    @id @default(cuid())
  orgId                   String
  title                   String
  summary                 String?
  body                    String
  category                String    @default("General")
  /// Bumped on every material edit. Acknowledgements are keyed by version, so
  /// a revised policy must be re-acknowledged rather than silently inheriting
  /// the old read receipts.
  version                 Int       @default(1)
  requiresAcknowledgement Boolean   @default(true)
  effectiveFrom           DateTime? @db.Date
  publishedAt             DateTime?
  isArchived              Boolean   @default(false)
  authorId                String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  org              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author           User?                   @relation("PolicyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  acknowledgements PolicyAcknowledgement[]

  @@index([orgId, isArchived])
  @@map("policies")
}

model PolicyAcknowledgement {
  id             String   @id @default(cuid())
  orgId          String
  policyId       String
  employeeId     String
  version        Int
  acknowledgedAt DateTime @default(now())
  ipAddress      String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy   Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId, version])
  @@index([orgId, employeeId])
  @@map("policy_acknowledgements")
}

/// Offer, experience, relieving and increment letters, with mail-merge tokens
/// like {{employee.firstName}} resolved at generation time.
model LetterTemplate {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  /// offer | experience | relieving | increment | confirmation | custom
  kind     String  @default("custom")
  subject  String
  body     String
  isActive Boolean @default(true)

  org     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  letters GeneratedLetter[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("letter_templates")
}

model GeneratedLetter {
  id          String    @id @default(cuid())
  orgId       String
  templateId  String?
  employeeId  String?
  candidateId String?
  title       String
  body        String
  issuedById  String?
  issuedAt    DateTime  @default(now())
  /// Basic e-signature: the signer types their name and we keep when and from
  /// where. Enough for an offer acceptance; not a qualified digital signature,
  /// and the UI says exactly that.
  signedAt    DateTime?
  signerName  String?
  signerIp    String?

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template  LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee  Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  issuedBy  User?           @relation("LetterIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId])
  @@map("generated_letters")
}

// ---------------------------------------------------------------------------
// Assets (PRD Â§8.15)
// ---------------------------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

model AssetCategory {
  id                String @id @default(cuid())
  orgId             String
  name              String
  /// Straight-line life in years â€” "depreciation-lite", as the PRD puts it.
  depreciationYears Int?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("asset_categories")
}

model Asset {
  id             String         @id @default(cuid())
  orgId          String
  categoryId     String?
  name           String
  assetTag       String
  serialNumber   String?
  make           String?
  model          String?
  purchaseDate   DateTime?      @db.Date
  purchaseCost   Decimal?       @db.Decimal(12, 2)
  warrantyEndsOn DateTime?      @db.Date
  locationId     String?
  status         AssetStatus    @default(AVAILABLE)
  condition      AssetCondition @default(GOOD)
  note           String?
  createdAt      DateTime       @default(now())

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category    AssetCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]

  @@unique([orgId, assetTag])
  @@index([orgId, status])
  @@map("assets")
}

model AssetAssignment {
  id              String          @id @default(cuid())
  orgId           String
  assetId         String
  employeeId      String
  issuedOn        DateTime        @db.Date
  dueOn           DateTime?       @db.Date
  returnedOn      DateTime?       @db.Date
  issueCondition  AssetCondition  @default(GOOD)
  returnCondition AssetCondition?
  issueNote       String?
  returnNote      String?
  issuedById      String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset    Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy User?        @relation("AssetIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId])
  @@index([orgId, assetId])
  @@map("asset_assignments")
}

// ---------------------------------------------------------------------------
// Expenses and reimbursement (PRD Â§8.16)
// ---------------------------------------------------------------------------

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
}

model ExpenseCategory {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  code            String
  /// Per-claim cap. Null = no ceiling.
  maxAmount       Decimal? @db.Decimal(12, 2)
  requiresReceipt Boolean  @default(true)
  isActive        Boolean  @default(true)

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items ExpenseItem[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("expense_categories")
}

model ExpenseClaim {
  id           String             @id @default(cuid())
  orgId        String
  employeeId   String
  title        String
  description  String?
  status       ExpenseClaimStatus @default(DRAFT)
  totalAmount  Decimal            @default(0) @db.Decimal(12, 2)
  submittedAt  DateTime?
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  /// Set when the claim rides along with a payroll run instead of being paid
  /// separately â€” the PRD asks for both routes.
  payrollRunId String?
  reimbursedAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee   Employee      @relation("ClaimOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver   Employee?     @relation("ClaimApprover", fields: [approverId], references: [id], onDelete: SetNull)
  payrollRun PayrollRun?   @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  items      ExpenseItem[]

  @@index([orgId, status])
  @@index([orgId, employeeId])
  @@map("expense_claims")
}

model ExpenseItem {
  id          String   @id @default(cuid())
  orgId       String
  claimId     String
  categoryId  String?
  description String
  spentOn     DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  merchant    String?
  costCenter  String?
  receiptUrl  String?

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claim    ExpenseClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([orgId, claimId])
  @@map("expense_items")
}

// ---------------------------------------------------------------------------
// HR helpdesk (PRD Â§8.19)
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model TicketCategory {
  id                String  @id @default(cuid())
  orgId             String
  name              String
  description       String?
  /// Resolution target in hours â€” what the SLA clock counts down to.
  slaHours          Int     @default(24)
  defaultAssigneeId String?
  isActive          Boolean @default(true)

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultAssignee Employee?    @relation("QueueDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  tickets         Ticket[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("ticket_categories")
}

model Ticket {
  id              String         @id @default(cuid())
  orgId           String
  /// Per-organisation counter, so employees can quote "#42" to HR.
  number          Int
  categoryId      String?
  requesterId     String
  subject         String
  body            String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assigneeId      String?
  /// Derived from the category SLA at creation.
  dueAt           DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category  TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requester Employee        @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  Employee?       @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  TicketComment[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, assigneeId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  orgId      String
  ticketId   String
  authorId   String?
  body       String
  /// Internal notes are visible to the HR queue but not to the requester.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?        @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId, ticketId])
  @@map("ticket_comments")
}

// ===========================================================================
// Phase 3 â€” Talent & growth
// ===========================================================================

// ---------------------------------------------------------------------------
// Recruitment / ATS (PRD Â§8.8)
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

/// The pipeline, in order. Stored as an enum rather than free text so the
/// kanban board, the funnel report and the automation all agree on what
/// "Interview" means.
enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewOutcome {
  PENDING
  STRONG_YES
  YES
  NO
  STRONG_NO
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model JobPosting {
  id              String         @id @default(cuid())
  orgId           String
  title           String
  /// Public URL segment on the careers page.
  slug            String
  departmentId    String?
  locationId      String?
  employmentType  EmploymentType @default(FULL_TIME)
  openings        Int            @default(1)
  description     String
  requirements    String?
  minCtc          Decimal?       @db.Decimal(14, 2)
  maxCtc          Decimal?       @db.Decimal(14, 2)
  status          JobStatus      @default(DRAFT)
  /// Listed on the public careers page when true and status is OPEN.
  isPublic        Boolean        @default(true)
  hiringManagerId String?
  recruiterId     String?
  createdById     String?
  publishedAt     DateTime?
  closesOn        DateTime?      @db.Date
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location      Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hiringManager Employee?    @relation("HiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiter     Employee?    @relation("Recruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  candidates    Candidate[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("job_postings")
}

model Candidate {
  id               String         @id @default(cuid())
  orgId            String
  jobPostingId     String
  firstName        String
  lastName         String
  email            String
  phone            String?
  resumeUrl        String?
  /// Plain text pulled out of the resume â€” what the light parser reads to
  /// suggest skills, and what search matches against.
  resumeText       String?
  /// careers-page | referral | linkedin | agency | direct
  source           String         @default("careers-page")
  referredById     String?
  currentCompany   String?
  currentCtc       Decimal?       @db.Decimal(14, 2)
  expectedCtc      Decimal?       @db.Decimal(14, 2)
  noticePeriodDays Int?
  skills           String[]       @default([])
  stage            CandidateStage @default(APPLIED)
  /// 1â€“5, set by the recruiter. Distinct from interview scorecards.
  rating           Int?
  rejectionReason  String?
  ownerId          String?
  appliedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job        JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  owner      Employee?         @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  interviews Interview[]
  offers     Offer[]
  letters    GeneratedLetter[]

  @@unique([jobPostingId, email])
  @@index([orgId, stage])
  @@index([orgId, jobPostingId])
  @@map("candidates")
}

model Interview {
  id              String           @id @default(cuid())
  orgId           String
  candidateId     String
  round           Int              @default(1)
  title           String
  scheduledAt     DateTime
  durationMinutes Int              @default(45)
  /// video | phone | onsite
  mode            String           @default("video")
  meetingUrl      String?
  interviewerId   String?
  outcome         InterviewOutcome @default(PENDING)
  /// Structured scorecard, kept as prose per competency rather than a single
  /// number â€” a "3/5" with no sentence behind it tells the next round nothing.
  feedback        String?
  score           Int?
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Employee?    @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([orgId, scheduledAt])
  @@index([orgId, candidateId])
  @@map("interviews")
}

model Offer {
  id            String      @id @default(cuid())
  orgId         String
  candidateId   String
  annualCtc     Decimal     @db.Decimal(14, 2)
  joiningDate   DateTime    @db.Date
  designation   String?
  status        OfferStatus @default(DRAFT)
  letterBody    String?
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresOn     DateTime?   @db.Date
  declineReason String?
  createdById   String?
  /// Set once the offer converts â€” the join between hiring and the employee
  /// record, so "time to hire" is answerable without manual reconciliation.
  employeeId    String?
  createdAt     DateTime    @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidate Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  employee  Employee?    @relation("OfferHire", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Performance (PRD Â§8.9)
// ---------------------------------------------------------------------------

enum GoalLevel {
  COMPANY
  DEPARTMENT
  INDIVIDUAL
}

enum GoalStatus {
  DRAFT
  ACTIVE
  AT_RISK
  ACHIEVED
  MISSED
  CANCELLED
}

enum ReviewCycleStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  CALIBRATION
  CLOSED
}

enum ReviewKind {
  SELF
  MANAGER
  PEER
}

enum ReviewStatus {
  PENDING
  SUBMITTED
}

model Goal {
  id           String     @id @default(cuid())
  orgId        String
  title        String
  description  String?
  level        GoalLevel  @default(INDIVIDUAL)
  ownerId      String?
  departmentId String?
  /// Cascading: company â†’ department â†’ individual, as the PRD describes.
  parentId     String?
  metric       String?
  targetValue  Decimal?   @db.Decimal(14, 2)
  currentValue Decimal?   @db.Decimal(14, 2)
  unit         String?
  /// Relative importance within the cycle, 1â€“100.
  weight       Int        @default(10)
  startDate    DateTime   @db.Date
  dueDate      DateTime   @db.Date
  status       GoalStatus @default(ACTIVE)
  progress     Int        @default(0)
  cycleId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner      Employee?    @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parent     Goal?        @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Goal[]       @relation("GoalTree")
  cycle      ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([orgId, ownerId, status])
  @@index([orgId, level])
  @@map("goals")
}

model ReviewCycle {
  id                  String            @id @default(cuid())
  orgId               String
  name                String
  periodStart         DateTime          @db.Date
  periodEnd           DateTime          @db.Date
  selfReviewDueOn     DateTime          @db.Date
  managerReviewDueOn  DateTime          @db.Date
  status              ReviewCycleStatus @default(DRAFT)
  includesPeerFeedback Boolean          @default(false)
  ratingScaleMax      Int               @default(5)
  instructions        String?
  createdAt           DateTime          @default(now())

  org     Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviews PerformanceReview[]
  goals   Goal[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@map("review_cycles")
}

model PerformanceReview {
  id            String       @id @default(cuid())
  orgId         String
  cycleId       String
  employeeId    String
  /// Null for a self-review â€” the subject is the reviewer.
  reviewerId    String?
  kind          ReviewKind
  status        ReviewStatus @default(PENDING)
  overallRating Int?
  strengths     String?
  improvements  String?
  comments      String?
  /// Visible to HR and the manager, never to the employee.
  privateNotes  String?
  submittedAt   DateTime?
  createdAt     DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cycle    ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee     @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee?    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([orgId, cycleId, employeeId])
  @@index([orgId, reviewerId, status])
  @@map("performance_reviews")
}

/// Continuous feedback: the 1:1 meeting record the PRD asks for, with the
/// action items that came out of it.
model OneOnOne {
  id          String    @id @default(cuid())
  orgId       String
  managerId   String
  employeeId  String
  scheduledAt DateTime
  agenda      String?
  notes       String?
  actionItems String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager  Employee     @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  employee Employee     @relation("OneOnOneEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, employeeId, scheduledAt])
  @@index([orgId, managerId])
  @@map("one_on_ones")
}

// ---------------------------------------------------------------------------
// Learning & development (PRD Â§8.10)
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  PDF
  LINK
  TEXT
}

enum EnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model Course {
  id              String       @id @default(cuid())
  orgId           String
  title           String
  slug            String
  summary         String?
  description     String?
  category        String       @default("General")
  durationMinutes Int          @default(30)
  status          CourseStatus @default(DRAFT)
  /// Compliance training (POSH, safety) that everyone must complete.
  isMandatory     Boolean      @default(false)
  /// Percentage needed to pass the quiz.
  passingScore    Int          @default(70)
  createdById     String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CourseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  lessons     CourseLesson[]
  questions   QuizQuestion[]
  enrollments CourseEnrollment[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("courses")
}

model CourseLesson {
  id              String     @id @default(cuid())
  orgId           String
  courseId        String
  title           String
  contentType     LessonType @default(TEXT)
  contentUrl      String?
  body            String?
  durationMinutes Int        @default(10)
  sortdex         Int        @default(0)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([orgId, courseId])
  @@map("course_lessons")
}

model QuizQuestion {
  id           String   @id @default(cuid())
  orgId        String
  courseId     String
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String?
  sortdex      Int      @default(0)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([orgId, courseId])
  @@map("quiz_questions")
}

model CourseEnrollment {
  id                String           @id @default(cuid())
  orgId             String
  courseId          String
  employeeId        String
  assignedById      String?
  assignedAt        DateTime         @default(now())
  dueOn             DateTime?        @db.Date
  startedAt         DateTime?
  completedAt       DateTime?
  status            EnrollmentStatus @default(ASSIGNED)
  /// 0â€“100, derived from lessons marked done.
  progress          Int              @default(0)
  lessonsCompleted  String[]         @default([])
  score             Int?
  attempts          Int              @default(0)
  /// Issued on passing â€” the completion certificate the PRD asks for.
  certificateNumber String?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy Employee?    @relation("EnrollmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([courseId, employeeId])
  @@index([orgId, employeeId, status])
  @@map("course_enrollments")
}

// ---------------------------------------------------------------------------
// Engagement (PRD Â§8.20)
// ---------------------------------------------------------------------------

enum SurveyKind {
  POLL
  SURVEY
  ENPS
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SurveyQuestionType {
  RATING_5
  SCALE_10
  SINGLE_CHOICE
  MULTI_CHOICE
  TEXT
}

model Survey {
  id          String       @id @default(cuid())
  orgId       String
  title       String
  description String?
  kind        SurveyKind   @default(SURVEY)
  status      SurveyStatus @default(DRAFT)
  /// Anonymous responses drop the employee link entirely rather than merely
  /// hiding it â€” a promise the database keeps, not just the UI.
  isAnonymous Boolean      @default(true)
  opensAt     DateTime?
  closesAt    DateTime?
  createdById String?
  createdAt   DateTime     @default(now())

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("SurveyAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([orgId, status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  orgId    String
  surveyId String
  prompt   String
  type     SurveyQuestionType @default(RATING_5)
  options  String[]           @default([])
  required Boolean            @default(true)
  sortdex  Int                @default(0)

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([orgId, surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id          String   @id @default(cuid())
  orgId       String
  surveyId    String
  /// Null on anonymous surveys.
  employeeId  String?
  submittedAt DateTime @default(now())

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  answers  SurveyAnswer[]

  @@index([orgId, surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id           String  @id @default(cuid())
  orgId        String
  responseId   String
  questionId   String
  value        String?
  numericValue Int?

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([orgId, questionId])
  @@map("survey_answers")
}

model AnnouncementReaction {
  id             String   @id @default(cuid())
  orgId          String
  announcementId String
  userId         String
  emoji          String   @default("ðŸ‘")
  createdAt      DateTime @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([orgId, announcementId])
  @@map("announcement_reactions")
}

// ---------------------------------------------------------------------------
// Exit management (PRD Â§8.21)
// ---------------------------------------------------------------------------

enum ExitType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  END_OF_CONTRACT
}

enum ResignationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum SettlementStatus {
  PENDING
  COMPUTED
  APPROVED
  PAID
}

model Resignation {
  id                      String            @id @default(cuid())
  orgId                   String
  employeeId              String
  exitType                ExitType          @default(RESIGNATION)
  reason                  String
  submittedAt             DateTime          @default(now())
  noticePeriodDays        Int               @default(30)
  lastWorkingDayRequested DateTime          @db.Date
  lastWorkingDayApproved  DateTime?         @db.Date
  status                  ResignationStatus @default(SUBMITTED)
  decidedById             String?
  decidedAt               DateTime?
  decisionNote            String?
  /// The offboarding checklist created when the resignation is accepted.
  clearanceInstanceId     String?           @unique

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee  Employee           @relation("ResignationOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee?          @relation("ResignationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  clearance ChecklistInstance? @relation(fields: [clearanceInstanceId], references: [id], onDelete: SetNull)

  exitInterview ExitInterview?
  settlement    FinalSettlement?

  @@index([orgId, status])
  @@index([orgId, employeeId])
  @@map("resignations")
}

model ExitInterview {
  id             String    @id @default(cuid())
  orgId          String
  resignationId  String    @unique
  employeeId     String
  conductedById  String?
  conductedAt    DateTime?
  /// compensation | growth | manager | relocation | workload | culture | other
  primaryReason  String?
  overallRating  Int?
  /// 0â€“10 â€” would they recommend the company as a place to work.
  wouldRecommend Int?
  whatWorked     String?
  whatDidNot     String?
  suggestions    String?
  submittedAt    DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resignation Resignation  @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  employee    Employee     @relation("ExitInterviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  conductedBy Employee?    @relation("ExitInterviewer", fields: [conductedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("exit_interviews")
}

/// Full and final settlement. Every figure is stored rather than recomputed on
/// read, because the numbers that were agreed at the time are the numbers that
/// were paid â€” later rule changes must not rewrite history.
model FinalSettlement {
  id                    String           @id @default(cuid())
  orgId                 String
  resignationId         String           @unique
  employeeId            String
  status                SettlementStatus @default(PENDING)
  /// Unused leave paid out.
  leaveEncashmentDays   Decimal          @default(0) @db.Decimal(6, 2)
  leaveEncashmentAmount Decimal          @default(0) @db.Decimal(14, 2)
  gratuityAmount        Decimal          @default(0) @db.Decimal(14, 2)
  pendingSalary         Decimal          @default(0) @db.Decimal(14, 2)
  pendingReimbursements Decimal          @default(0) @db.Decimal(14, 2)
  /// Loans outstanding, unreturned assets, notice shortfall.
  loanRecovery          Decimal          @default(0) @db.Decimal(14, 2)
  noticePayRecovery     Decimal          @default(0) @db.Decimal(14, 2)
  otherDeductions       Decimal          @default(0) @db.Decimal(14, 2)
  netPayable            Decimal          @default(0) @db.Decimal(14, 2)
  note                  String?
  computedAt            DateTime?
  approvedById          String?
  approvedAt            DateTime?
  paidAt                DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resignation Resignation  @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy  User?        @relation("SettlementApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@map("final_settlements")
}

// ===========================================================================
// Phase 4 â€” Scale & ecosystem
// ===========================================================================

/// API credentials for the public REST API (PRD Â§8.27).
///
/// Only a hash is stored. The plaintext key is shown once at creation and
/// never again â€” the same reasoning as passwords: a database dump must not
/// hand over live credentials.
model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  /// First 8 characters, kept in the clear so a key can be recognised in a list.
  prefix      String
  keyHash     String    @unique
  /// A subset of the caller permission catalogue â€” a key can never do more
  /// than the role that issued it.
  permissions String[]  @default([])
  createdById String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("api_keys")
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  FAILING
}

model WebhookEndpoint {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  url            String
  /// Signs the payload (HMAC-SHA256) so receivers can verify it came from us.
  secret         String
  /// Event names: employee.created, leave.approved, payroll.run.completedâ€¦
  events         String[]      @default([])
  status         WebhookStatus @default(ACTIVE)
  createdById    String?
  lastDeliveryAt DateTime?
  failureCount   Int           @default(0)
  createdAt      DateTime      @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([orgId, status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  orgId       String
  endpointId  String
  event       String
  payload     Json
  statusCode  Int?
  error       String?
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([orgId, endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// A saved definition for the custom report builder (PRD Â§8.13).
///
/// The definition is data, not SQL: a dataset name plus columns and filters
/// the server maps onto a whitelisted query. Storing SQL would hand every
/// report author a way to read another tenant.
model SavedReport {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  /// employees | attendance | leave | payroll | recruitment
  dataset     String
  columns     String[] @default([])
  filters     Json     @default("{}")
  groupBy     String?
  sortBy      String?
  /// Visible to everyone who can read the dataset, not just the author.
  isShared    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ReportAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("saved_reports")
}
